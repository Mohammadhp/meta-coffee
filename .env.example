# Copy to .env and adjust. .env is git-ignored.
#
# For local dev:
#   DEBUG=True
#   DB_HOST=127.0.0.1
#   DB_PORT=5433
#
# For production:
#   DEBUG=False
#   DB_HOST=db
#   DB_PORT=5432
#   ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
#   CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

SECRET_KEY=change-me-to-a-real-random-string
DEBUG=True
DB_NAME=metacoffee
DB_USER=metacoffee
DB_PASSWORD=metacoffee
DB_HOST=127.0.0.1
DB_PORT=5433
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
